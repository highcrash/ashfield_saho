{
  "name": "smart-home-estimator-server",
  "version": "2.0.0",
  "private": true,
  "description": "Smart Home Estimator: public estimator, admin panel and JSON API. SQLite (node:sqlite) locally, PostgreSQL + DigitalOcean Spaces in production.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "seed": "node --disable-warning=ExperimentalWarning seed.js",
    "import-catalog": "node --disable-warning=ExperimentalWarning seed.js --new-only",
    "backup": "node --disable-warning=ExperimentalWarning backup.js",
    "reset-password": "node --disable-warning=ExperimentalWarning reset-password.js",
    "check-spaces": "node check-spaces.js"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
